      "provider": "NeginErtebat",
      "mobile_list": [
        "09120000000",
        "09150000000"
      ],
      "message": "Good morning!",
      "expired_at": "2025-12-10"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
